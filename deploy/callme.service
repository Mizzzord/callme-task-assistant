[Unit]
Description=CallMe application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=callme
Group=callme
WorkingDirectory=/opt/callme
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DB_PATH=/var/lib/callme/app.sqlite
Environment=YANDEX_VAULT_DIR=/var/lib/callme/yandex-vault
EnvironmentFile=/etc/callme/callme.env
ExecStart=/usr/bin/node --import tsx server/index.ts
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/callme

[Install]
WantedBy=multi-user.target
